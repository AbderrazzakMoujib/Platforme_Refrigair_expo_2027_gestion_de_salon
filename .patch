+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Exhibitor;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class BadgeManagementTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private function exhibitorFor(User $user, int $quota = 2): Exhibitor
+    {
+        $commercial = User::factory()->create(['role' => 'commercial']);
+        $exhibitor = $commercial->exhibitors()->create([
+            'company_name' => 'Expo Test',
+            'contact_name' => 'Contact Test',
+            'email' => 'contact'. $user->id .'@example.test',
+            'phone' => '+212600000000',
+            'stand_number' => 'A12',
+            'area_sqm' => 12,
+            'authorized_badges' => $quota,
+        ]);
+        $user->exhibitorProfile()->save($exhibitor);
+
+        return $exhibitor;
+    }
+
+    private function badgeData(string $email): array
+    {
+        return [
+            'first_name' => 'Sara', 'last_name' => 'Test',
+            'function' => 'Responsable', 'email' => $email,
+            'phone' => '+212600000001',
+        ];
+    }
+
+    public function test_owner_can_create_update_and_delete_badges_within_quota(): void
+    {
+        $owner = User::factory()->create(['role' => 'exposant']);
+        $exhibitor = $this->exhibitorFor($owner, 2);
+        $this->actingAs($owner);
+
+        $this->get(route('exhibitor.badges.index'))->assertOk();
+        $this->get(route('exhibitor.badges.create'))->assertOk();
+        $this->post(route('exhibitor.badges.store'), $this->badgeData('one@example.test'))
+            ->assertRedirect(route('exhibitor.badges.index'));
+        $badge = $exhibitor->badges()->firstOrFail();
+        $this->get(route('exhibitor.badges.edit', $badge))->assertOk();
+        $this->put(route('exhibitor.badges.update', $badge), $this->badgeData('updated@example.test'))
+            ->assertRedirect();
+        $this->assertDatabaseHas('badges', ['id' => $badge->id, 'email' => 'updated@example.test']);
+        $this->delete(route('exhibitor.badges.destroy', $badge))->assertRedirect();
+        $this->assertDatabaseMissing('badges', ['id' => $badge->id]);
+    }
+
+    public function test_quota_is_enforced_at_exact_limit_and_zero_quota(): void
+    {
+        $owner = User::factory()->create(['role' => 'exposant']);
+        $exhibitor = $this->exhibitorFor($owner, 1);
+        $this->actingAs($owner);
+        $this->post(route('exhibitor.badges.store'), $this->badgeData('one@example.test'))
+            ->assertRedirect();
+        $this->post(route('exhibitor.badges.store'), $this->badgeData('two@example.test'))
+            ->assertStatus(422);
+        $this->assertSame(1, $exhibitor->badges()->count());
+        $exhibitor->update(['authorized_badges' => 0]);
+        $this->post(route('exhibitor.badges.store'), $this->badgeData('three@example.test'))
+            ->assertStatus(422);
+        $this->assertSame(1, $exhibitor->badges()->count());
+    }
+
+    public function test_other_exhibitor_cannot_view_edit_update_or_delete_badge(): void
+    {
+        $owner = User::factory()->create(['role' => 'exposant']);
+        $other = User::factory()->create(['role' => 'exposant']);
+        $exhibitor = $this->exhibitorFor($owner, 2);
+        $this->exhibitorFor($other, 2);
+        $badge = $exhibitor->badges()->create($this->badgeData('private@example.test'));
+
+        $this->actingAs($other)->get(route('exhibitor.badges.index'))
+            ->assertOk()->assertDontSee('private@example.test');
+        $this->get(route('exhibitor.badges.edit', $badge))->assertForbidden();
+        $this->put(route('exhibitor.badges.update', $badge), $this->badgeData('hacked@example.test'))
+            ->assertForbidden();
+        $this->delete(route('exhibitor.badges.destroy', $badge))->assertForbidden();
+        $this->assertDatabaseHas('badges', ['id' => $badge->id, 'email' => 'private@example.test']);
+    }
+}
